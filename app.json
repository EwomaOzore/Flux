{
  "expo": {
    "name": "Flux",
    "slug": "flux-budget",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "flux-budget",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.fluxbudget.app",
      "buildNumber": "1",
      "config": {
        "usesNonExemptEncryption": false
      },
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSFaceIDUsageDescription": "Flux uses Face ID or Touch ID to lock the app and protect your budget data."
      }
    },
    "android": {
      "package": "com.fluxbudget.app",
      "versionCode": 1,
      "softwareKeyboardLayoutMode": "resize",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/icon.png",
        "backgroundColor": "#000000"
      },
      "predictiveBackGestureEnabled": false,
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/icon.png"
    },
    "plugins": [
      [
        "expo-build-properties",
        {
          "ios": {
            "enableSceneSupport": true
          }
        }
      ],
      "./plugins/withBlackSplashWindow",
      "./plugins/withRemoveMicrophone",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#000000"
        }
      ],
      "expo-router",
      "@react-native-community/datetimepicker",
      [
        "expo-image-picker",
        {
          "photosPermission": "Flux uses your photos to attach receipt images for expenses.",
          "cameraPermission": "Flux uses the camera to scan receipts and add payday expenses."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/icon.png",
          "color": "#000000",
          "sounds": []
        }
      ],
      "./plugins/withStripPushNotifications",
      "expo-font",
      "expo-localization",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Flux uses Face ID or Touch ID to lock the app and protect your budget data."
        }
      ],
      "expo-sharing",
      "expo-status-bar",
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "privacyPolicyUrl": "https://flux-budget.expo.app/privacy",
      "termsOfServiceUrl": "https://flux-budget.expo.app/terms",
      "eas": {
        "projectId": "b20d201c-0232-48ec-a191-4884039a1c6b"
      }
    },
    "owner": "ewomaozore",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/b20d201c-0232-48ec-a191-4884039a1c6b"
    }
  }
}

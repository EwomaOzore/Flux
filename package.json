{
  "name": "flux",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "typecheck": "tsc --noEmit",
    "lint": "expo lint",
    "build:android": "npx eas build --profile production --platform android",
    "build:ios": "npx eas build --profile production --platform ios",
    "build:stores": "npx eas build --profile production --platform all",
    "submit:android": "npx eas submit --profile production --platform android --latest",
    "submit:ios": "npx eas submit --profile production --platform ios --latest",
    "submit:stores": "npx eas submit --profile production --platform all --latest",
    "update:prod": "npx eas update --channel production --environment production --auto"
  },
  "dependencies": {
    "@expo-google-fonts/fraunces": "^0.4.1",
    "@expo-google-fonts/instrument-sans": "^0.4.2",
    "@expo-google-fonts/jetbrains-mono": "^0.4.1",
    "@expo/vector-icons": "^15.1.1",
    "@gorhom/bottom-sheet": "^5.2.14",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/datetimepicker": "9.1.0",
    "babel-preset-expo": "~57.0.14",
    "expo": "~57.0.27",
    "expo-blur": "~57.0.3",
    "expo-build-properties": "~57.0.22",
    "expo-clipboard": "~57.0.2",
    "expo-constants": "~57.0.21",
    "expo-document-picker": "~57.0.3",
    "expo-file-system": "~57.0.7",
    "expo-font": "~57.0.4",
    "expo-haptics": "~57.0.3",
    "expo-image-picker": "~57.0.20",
    "expo-insights": "~57.0.21",
    "expo-linking": "~57.0.12",
    "expo-local-authentication": "~57.0.3",
    "expo-localization": "~57.0.2",
    "expo-notifications": "~57.0.22",
    "expo-router": "~57.0.25",
    "expo-sharing": "~57.0.22",
    "expo-splash-screen": "~57.0.9",
    "expo-status-bar": "~57.0.1",
    "expo-text-extractor": "^2.0.0",
    "expo-updates": "~57.0.25",
    "expo-web-browser": "~57.0.3",
    "pako": "^3.0.2",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-pager-view": "^9.0.4",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-tab-view": "^4.3.2",
    "react-native-worklets": "0.10.1",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@types/react": "~19.2.4",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~57.0.2",
    "react-test-renderer": "19.2.3",
    "typescript": "~6.0.3"
  },
  "private": true
}
